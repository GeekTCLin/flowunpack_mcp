# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/

# ---- 抓包与导出物（体积大） ----
*.pcap
*.pcapng
*.cap
exported_flows/
exports/
# 例外：bench/data 的样本抓包很小（<100KB），随仓库分发以保证真实协议基准可复现
!bench/data/*.pcap

# ---- 本地调试产物 ----
# bench/ 与诊断脚本把输出重定向到 _*.txt / _*.json，都是一次性调试产物。
# 只匹配下划线开头的文件，不会误伤 mcp-config-example.json 之类的正式配置。
_*.txt
_*.json
_*.log
*.log

# ---- 编辑器与系统 ----
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ---- 环境变量（可能含凭据，绝不入库） ----
.env
.env.*

# ---- WorkBuddy 工作区数据（本机工具配置，不入库） ----
.workbuddy/
