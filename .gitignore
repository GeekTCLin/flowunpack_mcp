# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/

# ---- 抓包与导出物（体积大） ----
*.pcap
*.pcapng
*.cap
exported_flows/
exports/

# ---- 本地调试产物 ----
# bench/ 与诊断脚本把输出重定向到 _*.txt / _*.json，都是一次性调试产物。
# 只匹配下划线开头的文件，不会误伤 mcp-config-example.json 之类的正式配置。
_*.txt
_*.json
_*.log
*.log

# ---- 编辑器与系统 ----
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ---- 环境变量（可能含凭据，绝不入库） ----
.env
.env.*

# ---- WorkBuddy 工作区数据 ----
# skills/ 是项目级可复用流程（一键回归清单），随仓库走；
# memory/ 是逐日工作流水，属于个人记录，不入库。
.workbuddy/*
!.workbuddy/skills/
